# OpenAI-compatible API Key (Generated dynamically by application or provided by user)
LLM_API_KEY=your_secure_api_key_here

# Local OpenAI-compatible API base endpoint
LLM_BASE_URL=http://127.0.0.1:18080/v1

# Google Colab session name
COLAB_SESSION_NAME=colab-llm-server

# Google Colab GPU accelerator type
COLAB_GPU_TYPE=T4

# Optional: Hugging Face User Access Token (for gated or private models)
HF_TOKEN=
